# cp .env.example .env   (.env Git'e girmez)

# Zeyrek App deposunun kökü. MCP buradaki zeyrek-mcp'den başlar; platform adresi, kuruluş ve kullanıcı
# zeyrek-mcp/.env dosyasından okunur. Argus bu bilgiyi kendisi tutmaz.
ARGUS_ZEYREK_APP_DIR=

# Kontrolcünün yapay zekâsı. Sayfanın ekran görüntüleri ve metni Anthropic'e gider. Yalnız Ayarlar'da sağlayıcı
# "API anahtarı" seçiliyse gerekir; varsayılan Claude hesabıdır (bu bilgisayarda claude → /login).
ANTHROPIC_API_KEY=

# Arayüz adresi: http://localhost:5300
ARGUS_PORT=5300

# Yerel veri (veritabanı, koşu görüntüleri) ve Git'te paylaşılan hafıza
ARGUS_DATA_DIR=./data
ARGUS_MEMORY_DIR=./memory
